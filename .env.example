# Direct Postgres connection used by ingest jobs (bypasses RLS). Never ship to the app.
DATABASE_URL=postgres://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# App (Expo). Copy these two lines into app/.env; Expo inlines EXPO_PUBLIC_* at
# build time, so they end up in the app bundle. Use the project's anon /
# publishable key only, never the service role key. Leave them unset and the
# app runs on built-in sample data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Dev only: run on offline sample data when Supabase isn't configured.
# EXPO_PUBLIC_USE_SAMPLE_DATA=1

# Purchases: 'mock' (default, works in Expo Go) or 'revenuecat' (EAS dev build only).
EXPO_PUBLIC_PURCHASES_PROVIDER=mock
# BLOCKED: no RevenueCat account yet. Public SDK keys go here once it exists.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
