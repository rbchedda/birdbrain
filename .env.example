# Direct Postgres connection used by ingest jobs (bypasses RLS). Never ship to the app.
DATABASE_URL=postgres://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# App (Expo). Copy these two lines into app/.env; Expo inlines EXPO_PUBLIC_* at
# build time, so they end up in the app bundle. Use the project's anon /
# publishable key only, never the service role key. Leave them unset and the
# app runs on built-in sample data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Dev only: run on offline sample data when Supabase isn't configured.
# EXPO_PUBLIC_USE_SAMPLE_DATA=1

# Paywall: OFF for v1 (launch free). Set to 1 to show passes again (needs RevenueCat).
# EXPO_PUBLIC_FLAG_PAYWALL=1
# Purchases (only used with the paywall on): 'mock' (default, works in Expo Go) or 'revenuecat' (EAS dev build only).
EXPO_PUBLIC_PURCHASES_PROVIDER=mock
# BLOCKED: no RevenueCat account yet. Public SDK keys go here once it exists.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Terrain basemap assets (PMTiles, DEM, glyphs). Dev: `npm run basemap:build` then
# `npm run basemap:serve` and point this at http://<your-lan-ip>:8787. Unset = no Terrain option.
# Production host (Cloudflare R2) is blocked for now.
# EXPO_PUBLIC_MAP_ASSETS_URL=http://192.168.1.20:8787

# Launch links (src/lib/env.ts). Unset = an obvious TODO_PUBLISH placeholder.
# Set real values as EAS env vars for production builds; docs/launch/publish-checklist.md.
# EXPO_PUBLIC_PRIVACY_URL=https://your-domain/privacy
# EXPO_PUBLIC_TERMS_URL=https://your-domain/terms
# EXPO_PUBLIC_SUPPORT_URL=https://your-domain/support
# EXPO_PUBLIC_SUPPORT_EMAIL=support@your-domain
# Form URL (gets ?place=<id>&name=<name>) or mailto:address
# EXPO_PUBLIC_MAP_ERROR_URL=mailto:support@your-domain

# Public origin for diary share links (serves web/share/). No trailing slash.
# EXPO_PUBLIC_SHARE_BASE_URL=https://share.example.com

# Diary share links (OFF until product turns the flag on).
# EXPO_PUBLIC_FLAG_DIARY_SHARE=1
# Diary share: public no-account viewer (OFF). SQL flag must also be enabled on hosted.
# EXPO_PUBLIC_FLAG_PUBLIC_DIARY_SHARE=1
# Owner-only share-link view totals (OFF). Display copy: "Viewed {n} times".
# EXPO_PUBLIC_FLAG_SHARE_LINK_VIEW_COUNTS=1
