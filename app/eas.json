{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "base": { "node": "22.12.0", "env": { "EXPO_PUBLIC_FLAG_APPLE_SIGN_IN": "0", "EXPO_PUBLIC_PURCHASES_PROVIDER": "mock" } },
    "development": { "extends": "base", "developmentClient": true, "distribution": "internal", "ios": { "simulator": true } },
    "preview": { "extends": "base", "distribution": "internal", "android": { "buildType": "apk" } },
    "production": {
      "extends": "base",
      
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_FLAG_APPLE_SIGN_IN": "0", "EXPO_PUBLIC_PURCHASES_PROVIDER": "mock" }
    }
  },
  "submit": { "production": {} }
}
